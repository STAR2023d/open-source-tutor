    {
      "id": "g5_g5_num_measurement_length_a2",
      "skillId": "g5.num.measurement.length",
      "bloom": "apply",
      "type": "multipleChoice",
      "prompt": "A rectangular field is 80 m long and 40 m wide. What is its perimeter?",
      "choices": [
        {
          "text": "240 m",
          "correct": true
        },
        {
          "text": "120 m",
          "misconception": "wrong_formula",
          "feedback": "Perimeter = 2 x (length + width) = 2 x (80 + 40) = 2 x 120 = 240 m, not 120 m."
        },
        {
          "text": "320 m",
          "misconception": "adds_wrong",
          "feedback": "Perimeter = 2 x (80 + 40) = 2 x 120 = 240 m, not 320 m."
        },
        {
          "text": "800 m",
          "misconception": "wrong_formula",
          "feedback": "Perimeter is 2 x (length + width), not length x width (that would be area)."
        }
      ],
      "hints": [
        "Perimeter = 2 x (length + width)",
        "= 2 x (80 + 40)",
        "= 2 x 120",
        "= 240 m"
      ],
      "explanation": "Perimeter = 2 x (80 + 40) = 2 x 120 = 240 m."
    },
