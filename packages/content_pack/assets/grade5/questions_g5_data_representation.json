          "text": "10",
          "misconception": "wrong_sub",
          "feedback": "30 - (10 + 8) = 30 - 18 = 12, not 10."
        },
        {
          "text": "12",
          "correct": true
        },
        {
          "text": "15",
          "misconception": "wrong_sub",
          "feedback": "30 - (10 + 8) = 30 - 18 = 12, not 15."
