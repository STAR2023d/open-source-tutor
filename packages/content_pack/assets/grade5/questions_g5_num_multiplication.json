    {
      "id": "g5_g5_num_multiplication_an1",
      "skillId": "g5.num.multiplication",
      "bloom": "analyze",
      "type": "multipleChoice",
      "prompt": "A rectangular garden has 18 rows of plants with 14 plants in each row. If the gardener adds 1 more row with 14 plants, how many plants will there be?",
      "choices": [
        {
          "text": "350 plants",
          "correct": true
        },
        {
          "text": "300 plants",
          "misconception": "wrong_partial",
          "feedback": "18 x 14 = 252, then adding 14 more = 266, not 300. 18 x 14 = 18 x 10 + 18 x 4 = 180 + 72 = 252."
        },
        {
          "text": "266 plants",
          "misconception": "wrong_place",
          "feedback": "18 x 14 = 252, plus 14 = 266. The total is 266 plants."
        },
        {
          "text": "252 plants",
          "misconception": "adds_row",
          "feedback": "The question says 1 more row is added, so add 14 to 252: 252 + 14 = 266."
        }
      ],
      "hints": [
        "First find 18 x 14",
        "18 x 14 = 18 x 10 + 18 x 4 = 180 + 72 = 252",
        "Then add 1 more row: 252 + 14 = 266"
      ],
      "explanation": "18 x 14 = 180 + 72 = 252. Adding 1 more row of 14 plants: 252 + 14 = 266 plants."
    },
