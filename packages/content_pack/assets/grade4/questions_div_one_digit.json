      "bloom": "remember",
      "type": "multipleChoice",
      "prompt": "What is 84 \u00f7 6?",
      "choices": [
        {
          "text": "14",
          "correct": true
        },
        {
          "text": "12",
          "misconception": "subtract_instead",
          "feedback": "84 \u00f7 6 is 14. Subtracting 6 eight times gives 0, not a quotient."
        },
        {
          "text": "18",
          "misconception": "multiply_backwards",
          "feedback": "This is 6 \u00d7 18, not 84 \u00f7 6."
        },
        {
          "text": "4",
          "misconception": "ones_digit_only",
          "feedback": "4 is the ones digit of 84, not the quotient."
        }
      ],
      "hints": [
        "Think: what number times 6 equals 84?",
        "6 \u00d7 10 = 60, and 6 \u00d7 4 = 24. 60 + 24 = 84."
      ],
      "explanation": "6 \u00d7 14 = 84, so 84 \u00f7 6 = 14."
    },
    {
      "id": "g4div-u1",
      "skillId": "g4.num.div.one-digit",
      "bloom": "understand",
      "type": "multipleChoice",
      "prompt": "A box holds 30 apples. How many boxes of 6 apples can you fill?",
      "choices": [
        {
          "text": "5",
          "correct": true
        },
        {
          "text": "24",
          "misconception": "subtracted_shared",
          "feedback": "24 is 30 minus 6, but the question asks how many groups of 6."
        },
        {
          "text": "180",
          "misconception": "multiplied_groups",
          "feedback": "180 is 30 \u00d7 6, but you are sharing 30 into groups of 6."
        },
        {
          "text": "6",
          "misconception": "used_divisor",
          "feedback": "6 is the size of each group, not the number of groups."
        }
      ],
      "hints": [
        "This is a sharing question: 30 apples shared into groups of 6.",
        "How many 6s are in 30? 6 \u00d7 5 = 30."
      ],
      "explanation": "30 \u00f7 6 = 5, so you can fill 5 boxes of 6 apples."
    },
    {
      "id": "g4div-r2",
      "skillId": "g4.num.div.one-digit",
      "bloom": "remember",
      "type": "multipleChoice",
      "prompt": "What is 8 \\u00d7 7?",
      "choices": [
        {
          "text": "56",
          "correct": true
        },
        {
          "text": "42",
          "misconception": "confused_table",
          "feedback": "8 \\u00d7 7 is 56, not 42 (42 is 6 \\u00d7 7)."
        },
        {
          "text": "54",
          "misconception": "off_by_two",
          "feedback": "8 \\u00d7 7 is 56, not 54."
        },
        {
          "text": "15",
          "misconception": "wrote_digits",
          "feedback": "15 is 3 \\u00d7 5 or 5 \\u00d7 3, not 8 \\u00d7 7."
        }
      ],
      "hints": [
        "Use the 7 times table.",
        "7 \\u00d7 8 = 7 \\u00d7 7 + 7 = 49 + 7 = 56."
      ],
      "explanation": "8 \\u00d7 7 = 56. (Multiplication is commutative, so 7 \\u00d7 8 = 56 too.)"
    },
    {
      "id": "g4div-u2",
      "skillId": "g4.num.div.one-digit",
      "bloom": "understand",
      "type": "multipleChoice",
      "prompt": "If 84 \\u00f7 6 = 14, which of these is also true?",
      "choices": [
        {
          "text": "6 \\u00d7 14 = 84",
          "correct": true
        },
        {
          "text": "6 + 14 = 20",
          "misconception": "added_not_multipled",
          "feedback": "84 \\u00f7 6 = 14 means 6 \\u00d7 14 = 84; adding is not the inverse."
        },
        {
          "text": "6 \\u00d7 4 = 24",
          "misconception": "ones_digit_only",
          "feedback": "The full product is 6 \\u00d7 14 = 84, not just 6 \\u00d7 4."
        },
        {
          "text": "14 \\u00d7 6 = 840",
          "misconception": "added_zero",
          "feedback": "14 \\u00d7 6 = 84, not 840. Do not add an extra zero."
        }
      ],
      "hints": [
        "Division and multiplication are inverse operations.",
        "If a \\u00f7 b = c, then c \\u00d7 b = a."
      ],
      "explanation": "If 84 \\u00f7 6 = 14, then multiplying the quotient by the divisor gives the dividend: 14 \\u00d7 6 = 84."
    },
